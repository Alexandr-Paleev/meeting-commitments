# Copy to .env.local and fill in. Server-side only; never commit real values.
# Defaults for the optional values live in lib/config.ts.

# Required
# Gemini API key, free from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
DEEPGRAM_API_KEY=
# Random secret for signing transcripts between the two API routes.
# Generate with: openssl rand -hex 32
TRANSCRIPT_SIGNING_SECRET=

# Optional
EXTRACT_MODEL=
EXTRACT_THINKING_LEVEL=
# Set to true only when GEMINI_API_KEY is on Gemini's paid tier: it lifts the block for
# visitors from the EEA, Switzerland and the UK (see lib/limits.ts).
GEMINI_PAID_TIER=
STT_MODEL=
RATE_LIMIT_PER_IP_PER_HOUR=
DAILY_REQUEST_CAP=
