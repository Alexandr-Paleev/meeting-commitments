# Copy to .env.local and fill in. Server-side only; never commit real values.
# Defaults for the optional values live in lib/config.ts.

# Required
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
# Random secret for signing transcripts between the two API routes.
# Generate with: openssl rand -hex 32
TRANSCRIPT_SIGNING_SECRET=

# Optional
EXTRACT_MODEL=
EXTRACT_EFFORT=
STT_MODEL=
RATE_LIMIT_PER_IP_PER_HOUR=
DAILY_REQUEST_CAP=
